GEMINI_API_KEY=your-gemini-api-key

# Local: docker compose up -d && uv run categoryrag
# Open http://localhost:5000 (must match APP_BASE_URL / Auth0 URLs)

# Auth0 (Regular Web App) — httpOnly JWT cookie auth
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=   # openssl rand -hex 32 (reserved; OAuth state uses random cookie)
APP_BASE_URL=http://localhost:5000
# Auth0 Allowed Callback URLs:  {APP_BASE_URL}/callback
# Auth0 Allowed Logout URLs:    {APP_BASE_URL}/login-page
# Auth0 Allowed Web Origins:    {APP_BASE_URL}

# Production: set ENV=production on the host and configure:
# DATABASE_URL, QDRANT_URL, QDRANT_API_KEY, S3_BUCKET,
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, S3_ENDPOINT_URL=
