GEMINI_API_KEY=your-gemini-api-key

# Local: docker compose up -d && uv run categoryrag
# (Postgres, MinIO, Qdrant on localhost — cloud vars in .env are ignored locally)

# Production: set ENV=production on the host and configure:
# DATABASE_URL, QDRANT_URL, QDRANT_API_KEY, S3_BUCKET,
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, S3_ENDPOINT_URL=
